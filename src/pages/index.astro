---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Home"
  description={site.description}
>
  <h1>{site.name}</h1>
  <p class="lede">{site.identitySummary}</p>
  <p class="scaffold-notice">
    The version 1 page scaffold structure is now in place. Verified content,
    final hero copy, and featured items will be added in later stages.
  </p>
</BaseLayout>
