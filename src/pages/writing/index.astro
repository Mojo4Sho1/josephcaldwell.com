---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../utils/paths";

const PUBLIC_RENDERABLE = ["public", "sanitized", "synthetic-demo"] as const;

const entries = await getCollection("writing", ({ data }) =>
  PUBLIC_RENDERABLE.includes(data.visibility),
);
---

<BaseLayout
  title="Writing"
  description="Publications, preprints, posters, talks, technical reports, and selected notes. Verified content will be added as the site is finalized."
>
  <h1>Writing</h1>
  <p class="scaffold-notice">
    Verified writing entries — including publications, preprints, posters,
    talks, technical reports, and selected notes — will be added here as the
    site content is finalized. This page is currently a scaffold placeholder.
  </p>
  {
    entries.length === 0 ? (
      <p class="empty-state" role="status">
        No writing entries are available yet.
      </p>
    ) : (
      <ul class="entry-list">
        {entries.map((entry) => (
          <li>
            <a href={withBase(`/writing/${entry.data.slug}/`)}>
              {entry.data.title}
            </a>
            <p>{entry.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
